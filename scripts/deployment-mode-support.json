{
  "$schemaVersion": "1.1.0",
  "shippingBaseline": {
    "stableTargetFramework": "net10.0",
    "readinessLaneTargetFramework": "net11.0",
    "readinessLaneStatus": "assessment-only"
  },
  "documentation": {
    "guidePath": "docs/deployment-mode-support.md",
    "readinessGuidePath": "docs/dotnet11-readiness.md",
    "compatibilityGuidePath": "docs/compatibility.md",
    "packagePublishingGuidePath": "docs/package-publishing.md",
    "validationHarnessPath": "scripts/validate-deployment-mode-claims.ps1",
    "validationHarnessTestsPath": "tests/Cephalon.Tests.Scripts/validate-deployment-mode-claims.Tests.ps1"
  },
  "analyzerOnlySignalsDoNotCount": true,
  "validationStrategy": "publish-required",
  "supportChangeRequirements": [
    "project properties that intentionally enable or declare the deployment mode",
    "scripts/validate-dotnet-readiness.ps1",
    "scripts/validate-deployment-mode-claims.ps1 must report claim-truthful",
    "release-validation workflow coverage",
    "docs/deployment-mode-support.md",
    "docs/compatibility.md",
    "docs/package-publishing.md",
    "docs/project-memory.md",
    "docs/engine-roadmap.md",
    "docs/engine-backlog.md"
  ],
  "deploymentModes": {
    "trim": {
      "status": "not-claimed",
      "summary": "Trimming is not part of the current Cephalon support contract.",
      "requiredProjectProperties": ["PublishTrimmed"],
      "requiredAnalyzerProperties": ["EnableTrimAnalyzer"],
      "warningPatterns": ["IL2026", "IL2067", "IL2070", "IL2075", "IL2080", "IL2090", "IL2104", "trim warning", "TrimAnalysis"]
    },
    "nativeAot": {
      "status": "not-claimed",
      "summary": "Native AOT is not part of the current Cephalon support contract.",
      "requiredProjectProperties": ["PublishAot"],
      "requiredAnalyzerProperties": ["IsAotCompatible"],
      "warningPatterns": ["IL3050", "IL3051", "IL3052", "IL3053", "IL3054", "IL2026", "AOT warning", "AOT analysis"]
    },
    "singleFile": {
      "status": "not-claimed",
      "summary": "Single-file publishing is not part of the current Cephalon support contract.",
      "requiredProjectProperties": ["PublishSingleFile"],
      "requiredAnalyzerProperties": ["EnableSingleFileAnalyzer"],
      "warningPatterns": ["IL3000", "IL3001", "IL3002", "single-file warning"]
    }
  },
  "representativePublishTargets": {
    "comment": "List the smallest set of csproj paths the harness should publish to honestly prove a claim. The harness defaults to this list when -PublishTargets is not passed and -SkipPublish is not set; pass -SkipPublish to force audit-only mode. Each target is published once per deployment mode (trim / nativeAot / singleFile); the audit-only verdict reports warnings but does not fail the build because the manifest still declares all three modes as not-claimed.",
    "projects": [
      "samples/Cephalon.Sample.ModularMonolith/Cephalon.Sample.ModularMonolith.csproj"
    ]
  },
  "expectedPublishOutputShape": {
    "trim": {
      "expectFile": "{output}/{assembly}.dll",
      "maxAllowedSizeBytes": null,
      "allowedWarningCategories": []
    },
    "nativeAot": {
      "expectFile": "{output}/{assembly}.exe",
      "maxAllowedSizeBytes": null,
      "allowedWarningCategories": []
    },
    "singleFile": {
      "expectFile": "{output}/{assembly}.exe",
      "maxAllowedSizeBytes": null,
      "allowedWarningCategories": []
    }
  },
  "deploymentModeEligibility": {
    "comment": "Per-package eligibility table seeded from docs/trim-aot-hazard-inventory.md (ENG-426). Each entry records the package's claim-audit tier, the actual reflection / dynamic-code call sites observed in its src/Cephalon.* source as of May 5, 2026, and the supportedModes a future claim could advertise (today: empty for every entry — the global manifest claim stays not-claimed until project properties + harness verdicts move). The list intentionally only enumerates packages that are NOT clean-baseline; the harness's project-property and analyzer audit phases scan all src/Cephalon.*.csproj automatically, so the absence of a package here means clean-baseline (no observed source-level hazard) rather than untracked. Excluded-by-design analyzer / source-generator projects are listed separately so the harness can confirm their disable-properties remain in place.",
    "packages": [
      {
        "packageName": "Cephalon.Engine",
        "nugetId": "Cephalon.Engine",
        "claimAuditTier": "high",
        "supportedModes": [],
        "requiredProjectProperties": [],
        "knownHazards": [
          {
            "kind": "reflection-assembly-scan",
            "site": "src/Cephalon.Engine/Composition/ModuleDiscovery.cs:113",
            "pattern": "Activator.CreateInstance(moduleType, nonPublic: true)",
            "remediation": "Replace assembly-scanned module discovery with a compile-time module manifest emitted by a source generator that registers IModule descriptors at startup."
          }
        ],
        "evidence": "docs/trim-aot-hazard-inventory.md (high tier)",
        "introducedBy": "ENG-426"
      },
      {
        "packageName": "Cephalon.Behaviors",
        "nugetId": "Cephalon.Behaviors",
        "claimAuditTier": "high",
        "supportedModes": [],
        "requiredProjectProperties": [],
        "knownHazards": [
          {
            "kind": "reflection-type-registry",
            "site": "src/Cephalon.Behaviors/Services/BehaviorTypeRegistry.cs",
            "pattern": "Runtime registry keyed by Type with late-bound resolution from descriptors",
            "remediation": "Replace runtime type registry with a compile-time descriptor + source-generator-emitted registration table; behaviors register via generated code rather than reflective discovery."
          }
        ],
        "evidence": "docs/trim-aot-hazard-inventory.md (high tier)",
        "introducedBy": "ENG-426"
      },
      {
        "packageName": "Cephalon.Behaviors.Patterns",
        "nugetId": "Cephalon.Behaviors.Patterns",
        "claimAuditTier": "high",
        "supportedModes": [],
        "requiredProjectProperties": [],
        "knownHazards": [
          {
            "kind": "reflection-open-generic",
            "site": "src/Cephalon.Behaviors.Patterns/Strategies/DurableExecutionStrategy.cs:386",
            "pattern": "typeof(DurableExecutionAdapter<,,,>).MakeGenericType(...) + Activator.CreateInstance(adapterType)",
            "remediation": "Source-gen-emitted closed-generic adapter table keyed by behavior identity so the four-arg generic shape (TBehavior, TInput, TOutput, TState) is materialized at compile time rather than at runtime."
          }
        ],
        "evidence": "docs/trim-aot-hazard-inventory.md (high tier)",
        "introducedBy": "ENG-426"
      },
      {
        "packageName": "Cephalon.Behaviors.Http",
        "nugetId": "Cephalon.Behaviors.Http",
        "claimAuditTier": "low",
        "supportedModes": [],
        "requiredProjectProperties": [],
        "knownHazards": [
          {
            "kind": "reflection-closed-generic-bounded",
            "site": "src/Cephalon.Behaviors.Http/Hosting/BehaviorRestEndpointGroup.cs:700",
            "pattern": "typeof(ResultModel<>).MakeGenericType(contract.ResponseType)",
            "remediation": "Either annotate the wrapper with [DynamicDependency] / [RequiresDynamicCode] preserving the bounded set of TResponse types, or emit the closed ResultModel<TResponse> through a source generator off the profile-contract list."
          }
        ],
        "evidence": "docs/trim-aot-hazard-inventory.md (low tier)",
        "introducedBy": "ENG-426"
      },
      {
        "packageName": "Cephalon.EventSourcing.Cassandra",
        "nugetId": "Cephalon.EventSourcing.Cassandra",
        "claimAuditTier": "medium",
        "supportedModes": [],
        "requiredProjectProperties": [],
        "knownHazards": [
          {
            "kind": "reflection-persisted-type-name",
            "site": "src/Cephalon.EventSourcing.Cassandra/CassandraEventStore.cs:158",
            "pattern": "Type.GetType(eventTypeName, throwOnError: false)",
            "remediation": "Replace Type.GetType with a Cephalon.EventSourcing compile-time event-type registry interface; the registry can be source-generated from the consuming app's event-contract assembly."
          }
        ],
        "evidence": "docs/trim-aot-hazard-inventory.md (medium tier)",
        "introducedBy": "ENG-426"
