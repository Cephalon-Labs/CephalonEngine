  "knownTransitiveHazards": {
    "comment": "Known third-party packages that emit trim or AOT warnings even when the consuming Cephalon.* project itself looks clean. Listed for reference; the harness does not currently fail on these but reports them in the per-target warnings list so the operator can see the source.",
    "trim": [
      "Newtonsoft.Json",
      "BenchmarkDotNet",
      "AutoMapper",
      "Microsoft.EntityFrameworkCore (reflection-heavy LINQ tracking)"
    ],
    "nativeAot": [
      "Newtonsoft.Json",
      "BenchmarkDotNet",
      "AutoMapper",
      "Microsoft.EntityFrameworkCore (model-builder dynamic code)",
      "Grpc.AspNetCore (reflection emit)",
      "AWSSDK.Core (native interop)",
      "Azure.Identity (native interop)",
      "Google.Cloud.* (native interop)"
    ],
    "singleFile": [
      "BenchmarkDotNet",
      "Plugins or providers that load assemblies dynamically at runtime"
    ]
  }
