<mxfile host="Electron" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) draw.io/28.0.6 Chrome/138.0.7204.100 Electron/37.2.3 Safari/537.36" version="28.0.6">
  <diagram id="cephalon-engine-roadmap" name="Cephalon Engine Roadmap">
    <mxGraphModel dx="1426" dy="841" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Cephalon Engine Roadmap" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=24;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="450" y="20" width="760" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="April 2, 2026 baseline: SDK hardening shipped, operational hardening now takes priority" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=12;fontColor=#666666;" parent="1" vertex="1">
          <mxGeometry x="390" y="58" width="880" height="24" as="geometry" />
        </mxCell>
        <mxCell id="foundation" value="Foundation Shipped&#xa;&#xa;- host-agnostic contracts&#xa;- configuration-driven engine&#xa;- assembly discovery&#xa;- manifest v2&#xa;- ASP.NET Core + worker hosts&#xa;- transports + adapters&#xa;- scaffolding + CLI&#xa;- observability + benchmarks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="70" y="150" width="250" height="240" as="geometry" />
        </mxCell>
        <mxCell id="phase1" value="Phase 1&#xa;SDK Hardening + External Adoption&#xa;SHIPPED&#xa;&#xa;- template/module/sample adoption path&#xa;- GraphQL transport delivery&#xa;- public-surface + compatibility hardening&#xa;- DocFX-ready XML comments&#xa;- generated output stays aligned" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="370" y="150" width="250" height="240" as="geometry" />
        </mxCell>
        <mxCell id="phase2" value="Phase 2&#xa;Operational Hardening&#xa;CURRENT FOCUS&#xa;&#xa;- readiness/liveness follow-through&#xa;- runtime failure + restart policy follow-through&#xa;- richer diagnostics + event IDs&#xa;- exporter packaging + operator visibility&#xa;- benchmark guardrails stay intentional" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cfe2f3;strokeColor=#3c78d8;fontSize=14;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="670" y="150" width="250" height="240" as="geometry" />
        </mxCell>
        <mxCell id="phase3" value="Phase 3&#xa;Extensibility + Package Loading&#xa;LATER&#xa;&#xa;- package discovery model&#xa;- compatibility checks&#xa;- explicit load-failure diagnostics&#xa;- version validation&#xa;- trust hooks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f9cb9c;strokeColor=#e69138;fontSize=14;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="970" y="150" width="250" height="240" as="geometry" />
        </mxCell>
        <mxCell id="phase4" value="Phase 4&#xa;Execution + Orchestration Model&#xa;DEFERRED&#xa;&#xa;- engine events&#xa;- hosted execution conventions&#xa;- workflow / execution graph&#xa;- multi-module coordination&#xa;- AI integration points" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8d5ff;strokeColor=#9673a6;fontSize=14;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="1270" y="150" width="250" height="240" as="geometry" />
        </mxCell>
        <mxCell id="phase5" value="Phase 5&#xa;Solution-Level Platform&#xa;FUTURE&#xa;&#xa;- `MicroserviceSuite` blueprint&#xa;- multi-service samples&#xa;- governance/convention packages&#xa;- optional gateway/control plane guidance" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="700" y="470" width="310" height="200" as="geometry" />
        </mxCell>
        <mxCell id="guardrails" value="Decision Guardrails&#xa;&#xa;- keep abstractions host-agnostic&#xa;- keep blueprint/transport/policy selection configuration-driven&#xa;- keep runtime, scaffolding, CLI, and package catalogs aligned&#xa;- benchmark hot paths before blind optimization&#xa;- do not start distributed orchestration before package loading + policy are stronger" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ead1dc;strokeColor=#c27ba0;fontSize=13;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="1090" y="450" width="410" height="230" as="geometry" />
        </mxCell>
        <mxCell id="sprint1" value="Sprint 1&#xa;&#xa;Delivered closeout&#xa;&#xa;ENG-005 / ENG-026 / ENG-027&#xa;SDK hardening exit slice" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9ead3;strokeColor=#6aa84f;fontSize=13;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="120" y="760" width="250" height="170" as="geometry" />
        </mxCell>
        <mxCell id="sprint2" value="Sprint 2&#xa;&#xa;Current phase-2 slice&#xa;&#xa;ENG-011 kickoff&#xa;Exporter packaging&#xa;Dependency-health follow-through" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0e0e3;strokeColor=#76a5af;fontSize=13;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="430" y="760" width="270" height="170" as="geometry" />
        </mxCell>
        <mxCell id="sprint3" value="Sprint 3&#xa;&#xa;Next hardening slice&#xa;&#xa;Structured diagnostics + event IDs&#xa;Runtime answers for loaded/started/failed state&#xa;ENG-013 planning readiness" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4cccc;strokeColor=#cc0000;fontSize=13;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="760" y="760" width="290" height="190" as="geometry" />
        </mxCell>
        <mxCell id="target" value="Target State&#xa;&#xa;Cephalon as an adoptable modular runtime platform&#xa;with stable packages, templates, multiple hosts,&#xa;extensible modules, and room to grow into platform scenarios" style="shape=cloud;whiteSpace=wrap;html=1;fillColor=#fce5cd;strokeColor=#e69138;fontSize=14;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="1130" y="760" width="350" height="190" as="geometry" />
        </mxCell>
