<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <!--
      Cephalon currently restores from a single feed. The mapping below makes that contract
      explicit so future feed splits (internal preview feed, mirror feed, GitHub Packages)
      can be added additively rather than silently widening the resolved-from set.
    -->
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
