<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- CA1707: Identifiers should not contain underscores. xUnit test method names commonly use underscores ("MethodName_WhenCondition_ShouldResult" style); suppress the rule project-wide. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="MongoDB.Driver" />
    <PackageReference Include="StackExchange.Redis" />
    <PackageReference Include="Testcontainers.Redis" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Cephalon.Abstractions\Cephalon.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\Cephalon.Data.Cassandra\Cephalon.Data.Cassandra.csproj" />
    <ProjectReference Include="..\..\src\Cephalon.Data.ClickHouse\Cephalon.Data.ClickHouse.csproj" />
    <ProjectReference Include="..\..\src\Cephalon.Data.Elasticsearch\Cephalon.Data.Elasticsearch.csproj" />
    <ProjectReference Include="..\..\src\Cephalon.Data.MongoDB\Cephalon.Data.MongoDB.csproj" />
    <ProjectReference Include="..\..\src\Cephalon.Data.Nats\Cephalon.Data.Nats.csproj" />
    <ProjectReference Include="..\..\src\Cephalon.Data.Neo4j\Cephalon.Data.Neo4j.csproj" />
    <ProjectReference Include="..\..\src\Cephalon.Data.OpenSearch\Cephalon.Data.OpenSearch.csproj" />
    <ProjectReference Include="..\..\src\Cephalon.Data.Qdrant\Cephalon.Data.Qdrant.csproj" />
    <ProjectReference Include="..\..\src\Cephalon.Data.Redis\Cephalon.Data.Redis.csproj" />
    <ProjectReference Include="..\..\src\Cephalon.Engine\Cephalon.Engine.csproj" />
    <ProjectReference Include="..\..\src\Cephalon.Eventing\Cephalon.Eventing.csproj" />
    <ProjectReference Include="..\..\src\Cephalon.EventSourcing.Redis\Cephalon.EventSourcing.Redis.csproj" />
    <ProjectReference Include="..\..\src\Cephalon.EventSourcing\Cephalon.EventSourcing.csproj" />
