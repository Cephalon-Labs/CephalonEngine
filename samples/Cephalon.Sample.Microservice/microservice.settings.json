{
  "Engine": {
    "Blueprint": "microservice",
    "Discovery": {
      "Assemblies": [
        "Cephalon.Sample.Microservice"
      ]
    },
    "Data": {
      "Ids": {
        "Generator": "Sfid"
      }
    },
    "Identity": {
      "Enabled": false,
      "AuthorizationModes": []
    },
    "Tenancy": {
      "Enabled": false
    },
    "Audit": {
      "Enabled": true
    },
    "Messaging": {},
    "Observability": {
      "LogManifestSummary": true,
      "LogModuleSummary": true,
      "LogCapabilitySummary": true
    },
    "Transports": [
      "rest-api"
    ]
  },
  "OpenApi": {
    "Title": "Cephalon Microservice Sample"
  },
  "ApiRoutes": {
    "DefaultBehaviorDocumentName": "v1",
    "ResultEnvelope": {
      "Enabled": true
    }
  }
}
