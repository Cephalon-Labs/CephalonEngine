<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Reference Cephalon module package that demonstrates lifecycle, localization, capabilities, and REST contribution.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Cephalon.Abstractions\Cephalon.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\Cephalon.AspNetCore\Cephalon.AspNetCore.csproj" />
    <ProjectReference Include="..\..\src\Cephalon.Engine.SourceGen\Cephalon.Engine.SourceGen.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      GlobalPropertiesToRemove="$(CephalonCompilerOnlyProjectReferenceGlobalPropertiesToRemove)" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="cephalon.package.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
