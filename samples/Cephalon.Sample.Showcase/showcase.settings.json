{
  "ConnectionStrings": {
    "WriteDb": "Host=localhost;Port=5432;Database=showcase_write;Username=showcase;Password=showcase_secret",
    "MongoDB": "mongodb://showcase:showcase_secret@localhost:27017",
    "Redis": "localhost:6379"
  },
  "Engine": {
    "Blueprint": "modular-monolith",
    "Discovery": {
      "Assemblies": [
        "Cephalon.Sample.Showcase"
      ]
    },
    "Patterns": [
      "strategy-pattern",
      "cqrs",
      "outbox",
      "event-sourcing"
    ],
    "Data": {
      "Provider": "EntityFramework",
      "ReadWriteSplit": false,
      "Outbox": {
        "Enabled": true
      },
      "Ids": {
        "Generator": "Sfid"
      },
      "MongoDB": {
        "ConnectionStringName": "MongoDB",
        "DatabaseName": "showcase_db",
        "CollectionPrefix": "showcase_"
      },
      "Redis": {
        "ConnectionStringName": "Redis",
        "KeyPrefix": "showcase:"
      }
    },
    "Databases": {
      "Runtime": {
        "EnableDetailedErrors": true,
        "EnableSensitiveDataLogging": false,
        "EnableRetryOnFailure": true,
        "MaxRetryCount": 5,
        "MaxRetryDelaySeconds": 10,
        "CommandTimeoutSeconds": 30,
        "MaxBatchSize": 128
      },
      "Write": {
        "Provider": "PostgreSql",
        "ConnectionStringName": "WriteDb",
        "Runtime": {
          "EnableRetryOnFailure": false
        }
      },
      "Migrations": {
        "ApplyOnStartup": false,
        "ExitAfterApply": false,
        "Targets": [
          "write"
        ]
      }
    },
    "Identity": {
      "Enabled": true,
      "AuthorizationModes": [
        "rbac"
      ]
    },
    "Tenancy": {
      "Enabled": true
    },
    "Audit": {
      "Enabled": true
    },
    "EventSourcing": {
      "Enabled": false
    },
    "Messaging": {
      "RabbitMQ": {
        "HostName": "localhost",
        "Port": 5672,
        "UserName": "showcase",
        "Password": "showcase_secret",
        "VirtualHost": "/"
      },
      "Kafka": {
        "BootstrapServers": "localhost:9092",
        "GroupId": "showcase-behaviors"
      }
    },
    "Observability": {
      "LogManifestSummary": true,
      "LogModuleSummary": true,
      "LogCapabilitySummary": true,
      "Telemetry": {
        "Provider": "OpenTelemetry",
        "Protocol": "otlp/grpc",
        "Endpoint": "http://localhost:4317",
        "UseSelfHostedDefaults": true,
        "ExportLogs": true,
        "ExportMetrics": true,
        "ExportTraces": true
      }
    },
    "Technologies": [
      "identity-access",
      "multi-tenancy",
      "event-driven-integration"
    ],
    "Transports": [
      "rest-api",
      "behavior-http"
    ]
  },
  "OpenApi": {
    "RoutePattern": "/openapi/{documentName}.json",
    "EnabledVersions": [ 1, 2 ],
    "DefaultVersion": 1,
    "Scalar": {
      "RoutePrefix": "/scalar"
    },
    "Title": "Cephalon Showcase Sample",
    "Description": "Comprehensive showcase exercising all 5 behavior patterns and 11 transports in CephalonEngine"
  },
  "ApiRoutes": {
    "ResultEnvelope": {
      "Enabled": true
    },
    "Prefixes": {
      "Rest": "/api",
      "GraphQL": "/graphql",
      "JsonRpc": "/json-rpc",
      "Grpc": "/grpc",
      "Ws": "/ws",
      "Sse": "/sse",
      "GraphQLWs": "/graphql-ws",
      "GraphQLSse": "/graphql-sse"
    }
  }
}
