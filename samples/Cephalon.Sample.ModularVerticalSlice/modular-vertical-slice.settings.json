{
  "Engine": {
    "Blueprint": "modular-vertical-slice",
    "Discovery": {
      "Assemblies": [
        "Cephalon.Sample.ModularVerticalSlice"
      ]
    },
    "Patterns": [
      "pipeline-pattern"
    ],
    "Data": {
      "Ids": {
        "Generator": "Sfid"
      }
    },
    "Identity": {
      "Enabled": false,
      "AuthorizationModes": []
    },
    "Tenancy": {
      "Enabled": false
    },
    "Audit": {
      "Enabled": true
    },
    "Messaging": {},
    "Observability": {
      "LogManifestSummary": true,
      "LogModuleSummary": true,
      "LogCapabilitySummary": true
    },
    "Transports": [
      "rest-api"

    ]
  },
  "OpenApi": {
    "Title": "Cephalon Modular Vertical Slice Sample"
  },
  "ApiRoutes": {
    "DefaultBehaviorDocumentName": "v1",
    "ResultEnvelope": {
      "Enabled": true
    },
    "Prefixes": {
      "Rest": "/api",
      "GraphQL": "/graphql",
      "JsonRpc": "/json-rpc",
      "Grpc": "/grpc",
      "Ws": "/ws",
      "Sse": "/sse",
      "GraphQLWs": "/graphql-ws",
      "GraphQLSse": "/graphql-sse"
    }
  }
}
