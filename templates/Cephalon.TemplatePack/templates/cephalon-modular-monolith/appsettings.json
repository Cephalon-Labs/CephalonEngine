{
  "Engine": {
    "Blueprint": "modular-monolith",
    "Discovery": {
      "Assemblies": [
        "CephalonTemplateApp"
      ]
    },
    "Patterns": [
      "strategy-pattern"
    ],
    "Data": {
      "Ids": {
        "Generator": "Sfid"
      }
    },
    "Identity": {
      "Enabled": false,
      "AuthorizationModes": []
    },
    "Tenancy": {
      "Enabled": false
    },
    "Audit": {
      "Enabled": true
    },
    "Messaging": {},
    "Observability": {
      "LogManifestSummary": true,
      "LogModuleSummary": true,
      "LogCapabilitySummary": true,
      "Telemetry": {
        "Provider": "OpenTelemetry",
        "Protocol": "otlp/http",
        "ExportLogs": true,
        "ExportMetrics": true,
        "ExportTraces": true
      }
    },
    "Transports": [
      "rest-api"
    ]
  },
  "ReferenceDocs": {
    "Enabled": false,
    "RoutePrefix": "/reference",
    "DirectoryPath": "..\\..\\docs\\reference",
    "DefaultDocument": "browse.html"
  },
  "OpenApi": {
    "Title": "CephalonTemplateApp API"
  }
}
