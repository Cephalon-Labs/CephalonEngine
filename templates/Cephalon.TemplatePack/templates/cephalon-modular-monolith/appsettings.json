{
  "Engine": {
    "Blueprint": "ModularMonolith",
    "Discovery": {
      "Assemblies": [
        "CephalonTemplateApp"
      ]
    },
    "Patterns": [
      "StrategyPattern"
    ],
    "Observability": {
      "LogManifestSummary": true,
      "LogModuleSummary": true,
      "LogCapabilitySummary": true,
      "Telemetry": {
        "Provider": "OpenTelemetry",
        "Protocol": "otlp",
        "Endpoint": "http://localhost:4317",
        "ExportLogs": true,
        "ExportMetrics": true,
        "ExportTraces": true
      }
    },
    "Transports": [
      "RestApi"
    ]
  },
  "ReferenceDocs": {
    "Enabled": false,
    "RoutePrefix": "/reference",
    "DirectoryPath": "..\\..\\docs\\reference",
    "DefaultDocument": "browse.html"
  },
  "OpenApi": {
    "Title": "CephalonTemplateApp API"
  }
}
