{
  "$schema": "http://json.schemastore.org/template",
  "author": "Cephalon",
  "classifications": [ "Cephalon", "ASP.NET Core", "Microservice", "Service" ],
  "identity": "Cephalon.Templates.Microservice",
  "name": "Cephalon Microservice",
  "shortName": "cephalon-microservice",
  "sourceName": "CephalonTemplateApp",
  "preferNameDirectory": true,
  "symbols": {
    "deploymentSlugBase": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "DeploymentSlugTransform"
    },
    "deploymentSlug": {
      "type": "generated",
      "generator": "casing",
      "parameters": {
        "source": "deploymentSlugBase",
        "toLower": true
      },
      "replaces": "cephalon-template-app"
    }
  },
  "forms": {
    "DeploymentSlugTransform": {
      "identifier": "replace",
      "pattern": "[^A-Za-z0-9]+",
      "replacement": "-"
    }
  },
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "primaryOutputs": [
    { "path": "CephalonTemplateApp.csproj" }
  ]
}
