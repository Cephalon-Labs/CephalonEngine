<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>cephalon</ToolCommandName>
    <PackageReadmeFile>PACKAGE.md</PackageReadmeFile>
    <Description>Command-line tooling for generating Cephalon applications from blueprints.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cephalon.Engine\Cephalon.Engine.csproj" />
    <ProjectReference Include="..\Cephalon.ReferenceDocs\Cephalon.ReferenceDocs.csproj" />
    <ProjectReference Include="..\Cephalon.Scaffolding\Cephalon.Scaffolding.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="PACKAGE.md" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\scripts\deployment-mode-support.json" LogicalName="Cephalon.Cli.Resources.deployment-mode-support.json" />
  </ItemGroup>
</Project>
