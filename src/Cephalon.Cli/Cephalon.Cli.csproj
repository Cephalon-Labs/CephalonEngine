<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>cephalon</ToolCommandName>
    <PackageReadmeFile>PACKAGE.md</PackageReadmeFile>
    <Description>Command-line tooling for generating Cephalon applications from blueprints.</Description>
    <!-- RS0026/RS0027: optional-overload patterns; suppressed for ENG-344. -->
    <NoWarn>$(NoWarn);RS0026;RS0027</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cephalon.Engine\Cephalon.Engine.csproj" />
    <ProjectReference Include="..\Cephalon.ReferenceDocs\Cephalon.ReferenceDocs.csproj" />
    <ProjectReference Include="..\Cephalon.Scaffolding\Cephalon.Scaffolding.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="PACKAGE.md" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\scripts\deployment-mode-support.json" LogicalName="Cephalon.Cli.Resources.deployment-mode-support.json" />
  </ItemGroup>
<ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>
</Project>