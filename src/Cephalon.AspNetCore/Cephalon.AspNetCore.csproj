<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>ASP.NET Core integration for the Cephalon runtime.</Description>
    <!--
      RS0026 / RS0027: PublicApiAnalyzers style rules flagging pre-existing optional-overload
      patterns. Suppressed so the public-API contract lock-in does not bundle a refactor;
      cleanup tracked as follow-up to `ENG-329`.
    -->
    <NoWarn>$(NoWarn);RS0026;RS0027</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Scalar.AspNetCore" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cephalon.Abstractions\Cephalon.Abstractions.csproj" />
    <ProjectReference Include="..\Cephalon.Diagnostics\Cephalon.Diagnostics.csproj" />
    <ProjectReference Include="..\Cephalon.Engine\Cephalon.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="wwwroot\js\openapi-toggle.js"
                      LogicalName="Cephalon.AspNetCore.Assets.openapi-toggle.js" />
    <EmbeddedResource Include="wwwroot\icons\docs-favicon.svg"
                      LogicalName="Cephalon.AspNetCore.Assets.docs-favicon.svg" />
  </ItemGroup>
</Project>
