<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>ASP.NET Core integration for the Cephalon runtime.</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Scalar.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cephalon.Abstractions\Cephalon.Abstractions.csproj" />
    <ProjectReference Include="..\Cephalon.Engine\Cephalon.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="wwwroot\js\openapi-toggle.js"
                      LogicalName="Cephalon.AspNetCore.Assets.openapi-toggle.js" />
    <EmbeddedResource Include="wwwroot\icons\docs-favicon.svg"
                      LogicalName="Cephalon.AspNetCore.Assets.docs-favicon.svg" />
  </ItemGroup>
</Project>
