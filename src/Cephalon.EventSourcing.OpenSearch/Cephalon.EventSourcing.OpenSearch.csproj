<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <LangVersion>latest</LangVersion>
    <Description>OpenSearch event-store provider for the Cephalon event-sourcing companion pack.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="OpenSearch.Client" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Cephalon.EventSourcing\Cephalon.EventSourcing.csproj" />
    <ProjectReference Include="..\Cephalon.Engine\Cephalon.Engine.csproj" />
  </ItemGroup>
</Project>
