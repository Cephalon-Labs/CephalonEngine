<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>Contracts for Cephalon modules and capabilities.</Description>
    <!--
      ENG-525: package-scoped single-file claim. This host-agnostic contract
      assembly has no active first-party deployment-mode hazards after the
      REST wire-name helper cleanup, so the manifest can validate its
      single-file analyzer posture without widening the global support claim.
    -->
    <PublishSingleFile>true</PublishSingleFile>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <!-- Analyzer dependencies of a meta-package project reference are not compiler inputs.
         Enforce this repository's API baseline directly; NuGet meta-package adoption is
         verified separately by the analyzer package consumer tests. -->
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>
</Project>
