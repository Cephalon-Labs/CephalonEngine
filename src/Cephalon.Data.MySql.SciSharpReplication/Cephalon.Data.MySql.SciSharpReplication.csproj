<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <LangVersion>latest</LangVersion>
    <Description>SciSharp-backed MySQL binlog transport adapter for the Cephalon MySQL data pack.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MySql.Data" />
    <PackageReference Include="SciSharp.MySQL.Replication" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cephalon.Data.MySql\Cephalon.Data.MySql.csproj" />
    <ProjectReference Include="..\Cephalon.Engine\Cephalon.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>
</Project>
