<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>Scaffolding and template generation for Cephalon app blueprints.</Description>
    <!--
      ENG-525: package-scoped single-file claim. The scaffolding companion is
      a clean-baseline generation library with no active first-party
      deployment-mode hazards, so the manifest can validate its single-file
      analyzer posture without widening the global support claim.
    -->
    <PublishSingleFile>true</PublishSingleFile>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cephalon.Abstractions\Cephalon.Abstractions.csproj" />
  </ItemGroup>
<ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>
</Project>
