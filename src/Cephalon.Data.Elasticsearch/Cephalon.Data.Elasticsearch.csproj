<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <LangVersion>latest</LangVersion>
    <Description>Elasticsearch search-store data companion package for the Cephalon engine.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Elastic.Clients.Elasticsearch" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Cephalon.Data\Cephalon.Data.csproj" />
    <ProjectReference Include="..\Cephalon.Engine\Cephalon.Engine.csproj" />
  </ItemGroup>
</Project>
