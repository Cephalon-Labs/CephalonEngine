<Project>
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591: Missing XML comment for publicly visible type or member. GenerateDocumentationFile=true emits CS1591 by default; suppress so internal package members (records, factories) don't require XML docs on every public surface. PublicApiAnalyzers (RS0016/RS0017) still tracks the public-API contract surface, which is the rule that actually matters. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <CephalonCompilerOnlyProjectReferenceGlobalPropertiesToRemove>PublishTrimmed;PublishAot;PublishSingleFile;SelfContained;RuntimeIdentifier;RuntimeIdentifiers</CephalonCompilerOnlyProjectReferenceGlobalPropertiesToRemove>
  </PropertyGroup>

  <PropertyGroup Condition="$([System.String]::Copy('$(MSBuildProjectName)').StartsWith('Cephalon.'))">
    <Authors Condition="'$(Authors)' == ''">Cephalon</Authors>
    <Version Condition="'$(Version)' == ''">0.1.0-preview</Version>
    <PackageVersion Condition="'$(PackageVersion)' == ''">$(Version)</PackageVersion>
    <PackageLicenseExpression Condition="'$(PackageLicenseExpression)' == ''">MIT</PackageLicenseExpression>
    <PackageProjectUrl Condition="'$(PackageProjectUrl)' == ''">https://github.com/Cephalon-Labs/CephalonEngine</PackageProjectUrl>
    <RepositoryUrl Condition="'$(RepositoryUrl)' == ''">https://github.com/Cephalon-Labs/CephalonEngine</RepositoryUrl>
    <RepositoryType Condition="'$(RepositoryType)' == ''">git</RepositoryType>
    <PublishRepositoryUrl Condition="'$(PublishRepositoryUrl)' == ''">true</PublishRepositoryUrl>
    <PackageTags Condition="'$(PackageTags)' == ''">cephalon;dotnet;framework;engine</PackageTags>
    <IncludeSymbols Condition="'$(IncludeSymbols)' == ''">true</IncludeSymbols>
    <SymbolPackageFormat Condition="'$(SymbolPackageFormat)' == ''">snupkg</SymbolPackageFormat>
    <PackageReadmeFile Condition="'$(IsPackable)' != 'false' and '$(PackageReadmeFile)' == ''">PACKAGE.md</PackageReadmeFile>
    <RestorePackagesWithLockFile Condition="'$(RestorePackagesWithLockFile)' == ''">true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup Condition="$([System.String]::Copy('$(MSBuildProjectName)').StartsWith('Cephalon.')) and '$(IsPackable)' != 'false' and '$(PackageReadmeFile)' == 'PACKAGE.md' and '$(MSBuildProjectName)' != 'Cephalon.TemplatePack' and !Exists('$(MSBuildProjectDirectory)\PACKAGE.md')">
    <None Include="$(MSBuildThisFileDirectory)docs\package-readme.md" Pack="true" PackagePath="PACKAGE.md" Link="PACKAGE.md" Visible="false" />
  </ItemGroup>

  <ItemGroup Condition="$([System.String]::Copy('$(MSBuildProjectName)').StartsWith('Cephalon.')) and '$(MSBuildProjectName)' != 'Cephalon.Analyzers' and '$(MSBuildProjectName)' != 'Cephalon.TemplatePack' and !$([System.String]::Copy('$(MSBuildProjectName)').EndsWith('.SourceGen'))">
    <ProjectReference Include="$(MSBuildThisFileDirectory)src\Cephalon.Engine.SourceGen\Cephalon.Engine.SourceGen.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      GlobalPropertiesToRemove="$(CephalonCompilerOnlyProjectReferenceGlobalPropertiesToRemove)">
      <PrivateAssets>all</PrivateAssets>
    </ProjectReference>
  </ItemGroup>
</Project>
