{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Engine": {
    "Blueprint": "ModularVerticalSlice",
    "Discovery": {
      "Assemblies": [
        "Cephalon.Playground"
      ]
    },
    "Patterns": [
      "StrategyPattern",
      "PipelinePattern"
    ],
    "Technologies": [
      "AgenticWorkloads",
      "EventDrivenIntegration",
      "KnowledgeRetrieval",
      "EdgeNativeDelivery",
      "DigitalTwinOrchestration"
    ],
    "Observability": {
      "LogManifestSummary": true,
      "LogModuleSummary": true,
      "LogCapabilitySummary": true,
      "Telemetry": {
        "Provider": "OpenTelemetry",
        "Protocol": "otlp",
        "Endpoint": "http://localhost:4317",
        "ExportLogs": true,
        "ExportMetrics": true,
        "ExportTraces": true
      }
    },
    "Localization": {
      "DefaultCulture": "en",
      "SupportedCultures": [
        "en",
        "th",
        "ja"
      ],
      "Resources": {
        "th": {
          "engine.docs.rest.title": "เอกสาร REST ของ Cephalon Playground",
          "engine.docs.rest.description": "พื้นผิว REST ภาษาไทยของ Cephalon Playground",
          "engine.docs.scalar.title": "คู่มือ REST ของ Cephalon Playground"
        },
        "ja": {
          "engine.docs.rest.title": "Cephalon Playground REST API 日本語",
          "engine.docs.rest.description": "Cephalon Playground の REST サーフェス",
          "engine.docs.scalar.title": "Cephalon Playground REST ガイド"
        }
      }
    },
    "Transports": [
      "RestApi",
      "JsonRpc",
      "Grpc",
      "ServerSentEvents",
      "WebSocket"
    ]
  },
  "ReferenceDocs": {
    "Enabled": true,
    "RoutePrefix": "/reference",
    "DirectoryPath": "..\\..\\docs\\reference",
    "DefaultDocument": "browse.html"
  },
  "AllowedHosts": "*"
}
