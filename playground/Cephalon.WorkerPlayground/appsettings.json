{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Engine": {
    "Blueprint": "ModularMonolith",
    "Discovery": {
      "Assemblies": [
        "Cephalon.WorkerPlayground"
      ]
    },
    "Patterns": [
      "PipelinePattern"
    ],
    "Observability": {
      "LogManifestSummary": true,
      "LogModuleSummary": true,
      "LogCapabilitySummary": true,
      "Telemetry": {
        "Provider": "OpenTelemetry",
        "Protocol": "otlp",
        "Endpoint": "http://localhost:4317",
        "ExportLogs": true,
        "ExportMetrics": true,
        "ExportTraces": true
      }
    },
    "Options": {
      "Capabilities": {
        "worker.heartbeat": true
      }
    }
  },
  "Worker": {
    "HeartbeatSeconds": 10
  }
}
